# Local Docker file ownership. Set this to the output of id -u on Linux/macOS.
AIRFLOW_UID=50000

# data: source evidence without LLM workers; model: legacy analysis.
PRODUCT_MODE=data

# Docker Compose passes only these explicit settings to the dashboard.
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
# Optional override; include /v1 for NVIDIA/OpenAI-compatible endpoints.
LLM_BASE_URL=
# NVIDIA Ultra: prompt; OpenAI/Gemini: json_schema. No automatic mode fallback.
LLM_RESPONSE_FORMAT=
# NVIDIA/Gemini: max_tokens; OpenAI: max_completion_tokens.
LLM_TOKEN_PARAMETER=
# Ultra defaults to none for short extraction budgets; no hidden thinking tokens.
LLM_REASONING_EFFORT=
LLM_DAILY_CALL_LIMIT=200
# When switching providers, set its model and matching key explicitly.
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=
